<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="25.0" style="-fx-background-color: #F0F9FF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.HistoryController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="25.0" />
    </padding>

    <!-- 1. Header Card: Giữ nguyên style sạch sẽ -->
    <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);">
        <children>
            <Label text="Lịch sử đấu giá" textFill="#1a73e8">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            <Label text="Theo dõi và quản lý các phiên đấu giá bạn đã tham gia" textFill="#64748b">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
        </children>
    </VBox>

    <!-- 2. Thẻ thống kê: Đã sửa màu Xanh dương và thêm Border màu nổi bật -->
    <HBox spacing="20.0">
        <children>
            <!-- Tổng phiên: Chuyển từ đen sang Gradient Xanh dương (UET style) -->
            <VBox prefHeight="110.0" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: linear-gradient(to bottom right, #1a73e8, #0d47a1);
                         -fx-background-radius: 15;
                         -fx-padding: 20;
                         -fx-effect: dropshadow(three-pass-box, rgba(26, 115, 232, 0.3), 10, 0, 0, 5);">
                <children>
                    <Label text="Tổng phiên tham gia" textFill="#e3f2fd" />
                    <Label fx:id="totalSessionsLabel" text="0" textFill="WHITE">
                        <font><Font name="System Bold" size="32.0" /></font>
                    </Label>
                </children>
            </VBox>

            <!-- Phiên thắng: Trắng với Border đáy màu Xanh lá -->
            <VBox prefHeight="110.0" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 15;
                         -fx-padding: 20;
                         -fx-border-color: #10b981;
                         -fx-border-width: 0 0 4 0;
                         -fx-border-radius: 15;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                <children>
                    <Label text="🏆 Phiên thắng" textFill="#64748b" />
                    <Label fx:id="wonSessionsLabel" text="0" textFill="#10b981">
                        <font><Font name="System Bold" size="32.0" /></font>
                    </Label>
                </children>
            </VBox>

            <!-- Phiên thua: Trắng với Border đáy màu Đỏ -->
            <VBox prefHeight="110.0" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 15;
                         -fx-padding: 20;
                         -fx-border-color: #ef4444;
                         -fx-border-width: 0 0 4 0;
                         -fx-border-radius: 15;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                <children>
                    <Label text="❌ Phiên thua" textFill="#64748b" />
                    <Label fx:id="lostSessionsLabel" text="0" textFill="#ef4444">
                        <font><Font name="System Bold" size="32.0" /></font>
                    </Label>
                </children>
            </VBox>
        </children>
    </HBox>

    <!-- 3. Bảng dữ liệu: Giữ nguyên khung bảng chuyên nghiệp -->
    <VBox spacing="15.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 8);">
        <children>
            <HBox alignment="CENTER_LEFT">
                <children>
                    <Label text="Chi tiết giao dịch" textFill="#1e293b">
                        <font><Font name="System Bold" size="18.0" /></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="🔄 Làm mới" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-cursor: hand;" />
                </children>
            </HBox>

            <TableView fx:id="historyTable" prefHeight="400.0" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10;">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="75.0" text="Mã ID" />
                    <TableColumn fx:id="colProduct" prefWidth="250.0" text="Sản phẩm" />
                    <TableColumn fx:id="colDate" prefWidth="150.0" text="Ngày đấu" />
                    <TableColumn fx:id="colPrice" prefWidth="120.0" text="Giá cuối" />
                    <TableColumn fx:id="colStatus" prefWidth="120.0" text="Trạng thái" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </children>
    </VBox>
</VBox>