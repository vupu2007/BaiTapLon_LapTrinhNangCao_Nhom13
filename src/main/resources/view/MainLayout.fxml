<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.URL?>

<BorderPane fx:id="root"
            style="-fx-background-color: #F0F9FF;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.MainLayoutController">

    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="70.0"
              spacing="20.0"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="30.0" right="30.0"/>
            </padding>

            <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../images/uet_logo.png"/>
            </ImageView>

            <VBox alignment="CENTER_LEFT">
                <Label text="Đấu Giá UET" textFill="#0056b3" style="-fx-font-weight: bold; -fx-font-size: 20;"/>
                <Label text="Đại học Công nghệ - ĐHQGHN" textFill="#64748b" style="-fx-font-size: 10;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="👤 minh huyền"
                   style="-fx-background-color: #f1f5f9; -fx-padding: 8 15; -fx-background-radius: 10;"/>

            <MenuButton fx:id="roleMenuButton"
                        text="🔄 Người mua"
                        textFill="WHITE"
                        style="-fx-background-color: #A21CAF; -fx-background-radius: 10;">
                <items>
                    <MenuItem text="Người mua - Tham gia đấu giá" onAction="#switchToBuyer"/>
                    <MenuItem text="Người bán - Quản lý sản phẩm" onAction="#switchToSeller"/>
                </items>
                <font>
                    <Font name="System Bold" size="13.0"/>
                </font>
            </MenuButton>

            <Button text="🚪 Đăng xuất" styleClass="btn-logout" />
        </HBox>
    </top>

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox prefWidth="260.0" spacing="15.0">
            <padding>
                <Insets top="25.0" right="10.0" bottom="20.0" left="25.0"/>
            </padding>

            <VBox fx:id="roleBox" style="-fx-background-color: #fae8ff; -fx-background-radius: 15; -fx-padding: 20;">
                <Label text="Tư cách hiện tại" textFill="#86198f" style="-fx-font-size: 11;"/>
                <Label fx:id="lblRoleSidebar" text="🛒 Người mua" textFill="#86198f">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>
            </VBox>

            <VBox spacing="8.0" styleClass="shadow-pane" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="20.0" right="15.0" bottom="20.0" left="15.0"/>
                </padding>

                <Button fx:id="btnHome" text="🏠 Trang chủ" prefHeight="45.0" maxWidth="1.7976931348623157E308"
                        alignment="BASELINE_LEFT" styleClass="nav-button-active" onAction="#openHome"/>

                <Button fx:id="btnWallet" text="👛 Ví tiền" prefHeight="45.0" maxWidth="1.7976931348623157E308"
                        alignment="BASELINE_LEFT" styleClass="nav-button" onAction="#openWallet"/>

                <VBox fx:id="buyerMenu" spacing="8.0">
                    <Button fx:id="btnAuction" text="🔨 Đang đấu giá" prefHeight="45.0" maxWidth="1.7976931348623157E308"
                            alignment="BASELINE_LEFT" styleClass="nav-button" onAction="#openAuction"/>
                </VBox>

                <VBox fx:id="sellerMenu" spacing="8.0" visible="false" managed="false">
                    <Button fx:id="btnSelling" text="📦 Đang bán" prefHeight="45.0" maxWidth="1.7976931348623157E308"
                            alignment="BASELINE_LEFT" styleClass="nav-button" onAction="#openSelling"/>
                    <Button fx:id="btnCreateAuction" text="➕ Tạo phiên đấu giá" prefHeight="45.0" maxWidth="1.7976931348623157E308"
                            alignment="BASELINE_LEFT" styleClass="nav-button" onAction="#openCreateAuction"/>
                </VBox>

                <Button fx:id="btnHistory" text="🕒 Lịch sử" prefHeight="45.0" maxWidth="1.7976931348623157E308"
                        alignment="BASELINE_LEFT" styleClass="nav-button" onAction="#openHistory"/>

                <Button fx:id="btnSettings" text="⚙ Cài đặt" prefHeight="45.0" maxWidth="1.7976931348623157E308"
                        alignment="BASELINE_LEFT" styleClass="nav-button" onAction="#openSettings"/>
            </VBox>
        </VBox>
    </left>

    <!-- ================= CONTENT AREA ================= -->
    <center>
        <!-- Thêm các thuộc tính ép giãn cho StackPane -->
        <StackPane fx:id="contentArea"
                   alignment="TOP_CENTER"
                   maxHeight="1.7976931348623157E308"
                   maxWidth="1.7976931348623157E308"
                   BorderPane.alignment="CENTER" />
    </center>

</BorderPane>