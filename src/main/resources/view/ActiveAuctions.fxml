<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="673.0" prefWidth="816.0" spacing="20.0" style="-fx-background-color: #f3f4f6; -fx-padding: 30;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label text="&lt;&gt; Phiên đang đấu giá" textFill="#1f2937">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <!-- Thanh tìm kiếm và lọc -->
        <HBox spacing="10.0">
            <children>
                <TextField prefWidth="350.0" promptText="Tìm kiếm sản phẩm đang đấu giá..." style="-fx-background-radius: 6; -fx-padding: 10; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-color: white;" />
                <Button mnemonicParsing="false" style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 20; -fx-font-weight: bold;" text="Tìm kiếm" />
            </children>
        </HBox>

        <!-- Danh sách các phiên (Cuộn được) -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="15.0">
                    <children>
                        <!-- Card Sản phẩm 1 -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="📱 iPhone 15 Pro Max 256GB Titan" textFill="#1f2937">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                        <Label text="Người đăng: admin_store" textFill="#6b7280" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <VBox alignment="CENTER_RIGHT" spacing="5.0">
                                    <children>
                                        <Label text="Giá hiện tại:" textFill="#6b7280" />
                                        <Label text="24,500,000 đ" textFill="#ef4444">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" spacing="5.0" style="-fx-padding: 0 20 0 20;">
                                    <children>
                                        <Label text="Thời gian còn lại" textFill="#6b7280" />
                                        <Label text="02:15:45" textFill="#f59e0b">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <Button mnemonicParsing="false" style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 20; -fx-font-weight: bold;" text="Vào phòng đấu" />
                            </children>
                        </HBox>

                        <!-- Card Sản phẩm 2 -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="💻 MacBook Pro M3 16GB 512GB" textFill="#1f2937">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                        <Label text="Người đăng: mac_world" textFill="#6b7280" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <VBox alignment="CENTER_RIGHT" spacing="5.0">
                                    <children>
                                        <Label text="Giá hiện tại:" textFill="#6b7280" />
                                        <Label text="38,000,000 đ" textFill="#ef4444">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" spacing="5.0" style="-fx-padding: 0 20 0 20;">
                                    <children>
                                        <Label text="Thời gian còn lại" textFill="#6b7280" />
                                        <Label text="14:05:10" textFill="#f59e0b">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <Button mnemonicParsing="false" style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 20; -fx-font-weight: bold;" text="Vào phòng đấu" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="5.0" right="5.0" top="5.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
