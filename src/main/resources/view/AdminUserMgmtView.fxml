<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.admin.AdminUserMgmtController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="Danh Sách Thành Viên" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label text="Xem thông tin tài khoản, số dư và thực hiện khóa tài khoản vi phạm" textFill="#64748b" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtSearch" prefHeight="38.0" prefWidth="250.0" promptText="Tìm kiếm tài khoản..." style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1;" />
            </children>
        </HBox>

        <TableView fx:id="userTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;">
            <columns>
                <TableColumn fx:id="colUsername" prefWidth="180.0" text="Tên tài khoản" />
                <TableColumn fx:id="colRole" prefWidth="120.0" text="Vai trò" />
                <TableColumn fx:id="colBalance" prefWidth="180.0" text="Số dư hiện tại" />
                <TableColumn fx:id="colStatus" prefWidth="140.0" text="Trạng thái" />
                <TableColumn fx:id="colAction" prefWidth="150.0" text="Hành động khẩn cấp" />
            </columns>
        </TableView>
    </children>
</VBox>