<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AdminItemMgmtController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="Danh Sách Sản Phẩm Đấu Giá" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label text="Giám sát các phiên đấu giá, theo dõi mức giá và gỡ bỏ các sản phẩm vi phạm" textFill="#64748b" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtSearch" prefHeight="38.0" prefWidth="250.0" promptText="Tìm kiếm sản phẩm..." style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1;" />
            </children>
        </HBox>

        <TableView fx:id="itemTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;">
            <columns>
                <TableColumn fx:id="colItemId" prefWidth="80.0" text="Mã SP" />
                <TableColumn fx:id="colItemName" prefWidth="220.0" text="Tên sản phẩm" />
                <TableColumn fx:id="colSeller" prefWidth="140.0" text="Người đăng bán" />
                <TableColumn fx:id="colCurrentPrice" prefWidth="150.0" text="Giá hiện tại" />
                <TableColumn fx:id="colStatus" prefWidth="130.0" text="Trạng thái phiên" />
                <TableColumn fx:id="colAction" prefWidth="150.0" text="Hành động" />
            </columns>
        </TableView>
    </children>
</VBox>
