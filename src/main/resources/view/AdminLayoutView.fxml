<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" style="-fx-background-color: #F0F9FF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AdminLayoutController">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>

            <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../images/uet_logo.png" />
            </ImageView>

            <VBox alignment="CENTER_LEFT">
                <Label style="-fx-font-weight: bold; -fx-font-size: 20;" text="Đấu Giá UET" textFill="#0056b3" />
                <Label style="-fx-font-size: 10;" text="Đại học Công nghệ - ĐHQGHN" textFill="#64748b" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="nameLabel" style="-fx-background-color: #f1f5f9; -fx-padding: 8 15; -fx-background-radius: 10;" text="👤 System Admin" />

            <Button onAction="#handleLogout" styleClass="btn-logout" text="🚪 Đăng xuất" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="260.0" spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="10.0" top="25.0" />
            </padding>

            <VBox fx:id="roleBox" style="-fx-background-color: #fae8ff; -fx-background-radius: 15; -fx-padding: 20;">
                <Label style="-fx-font-size: 11;" text="Tư cách hiện tại" textFill="#86198f" />
                <Label fx:id="lblRoleSidebar" text="🔑 Admin" textFill="#86198f" style="-fx-font-weight: bold; -fx-font-size: 18.0;" />
            </VBox>

            <VBox spacing="8.0" styleClass="shadow-pane" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
                </padding>

                <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" onAction="#openDashboard" prefHeight="45.0" styleClass="nav-button" text="📊 Tổng quan" />

                <Button fx:id="btnUserMgmt" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" onAction="#openUserMgmt" prefHeight="45.0" styleClass="nav-button" text="👥 Quản lý thành viên" />

                <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" onAction="#backToUserView" prefHeight="45.0" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold;" text="🔄 Về trang người dùng" />
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="adminContentArea" alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="20.0" top="25.0" />
            </padding>
        </StackPane>
    </center>
</BorderPane>