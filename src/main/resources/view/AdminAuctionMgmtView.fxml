<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AdminAuctionMgmtController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="Quản Lý Phiên Đấu Giá" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label text="Theo dõi các phiên đang diễn ra, kiểm soát người bán và thực hiện thao tác quản trị" textFill="#64748b" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtSearch" prefHeight="40.0" prefWidth="300.0" promptText="Tìm kiếm tên sản phẩm hoặc người bán..." style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #cbd5e1; -fx-padding: 0 15;" />
            </children>
        </HBox>

        <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-selection-bar: #f8fafc;">
            <columns>
                <TableColumn fx:id="colProduct" prefWidth="350.0" text="Sản phẩm" />

                <TableColumn fx:id="colSeller" prefWidth="150.0" text="Người bán" />

                <TableColumn fx:id="colPrice" prefWidth="180.0" text="Giá hiện tại" />

                <TableColumn fx:id="colBids" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Lượt đấu" />

                <TableColumn fx:id="colStatus" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Trạng thái" />

                <TableColumn fx:id="colEndTime" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Kết thúc" />

                <TableColumn fx:id="colActions" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Thao tác" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="20.0">
            <children>
                <Label text="Tổng số phiên:" textFill="#64748b" />
                <Label fx:id="lblTotalAuctions" text="128" textFill="#0f172a" style="-fx-font-weight: bold;" />
            </children>
        </HBox>
    </children>
</VBox>