<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane alignment="CENTER" prefHeight="750.0" prefWidth="500.0"
           style="-fx-background-color: #f0f7ff;"
           stylesheets="@../css/login.css"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.controller.RegisterController">

    <children>
        <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
              prefWidth="420.0" spacing="12.0" styleClass="login-card">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@../images/uet_logo.png" />
                    </image>
                </ImageView>

                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label styleClass="title-main" text="Đăng ký tài khoản" />
                        <Label styleClass="title-sub" text="Tham gia Đấu Giá UET ngay hôm nay" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </VBox>

                <VBox spacing="12.0">
                    <children>
                        <VBox spacing="5.0">
                            <Label styleClass="field-label" text="Tên đăng nhập" />
                            <TextField fx:id="usernameField" promptText="Nhập tên đăng nhập" styleClass="input-field" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label styleClass="field-label" text="Email" />
                            <TextField fx:id="emailField" promptText="Nhập email" styleClass="input-field" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label styleClass="field-label" text="Mật khẩu" />
                            <StackPane alignment="CENTER_RIGHT">
                                <children>
                                    <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu (tối thiểu 6 ký tự)" styleClass="input-field" />
                                    <TextField fx:id="passwordTextField" promptText="Nhập mật khẩu (tối thiểu 6 ký tự)" styleClass="input-field" visible="false" />
                                    <ToggleButton fx:id="togglePasswordBtn" mnemonicParsing="false" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand;" text="👁">
                                        <StackPane.margin>
                                            <Insets right="5.0" />
                                        </StackPane.margin>
                                    </ToggleButton>
                                </children>
                            </StackPane>
                        </VBox>

                        <VBox spacing="5.0">
                            <Label styleClass="field-label" text="Xác nhận mật khẩu" />
                            <StackPane alignment="CENTER_RIGHT">
                                <children>
                                    <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu" styleClass="input-field" />
                                    <TextField fx:id="confirmPasswordTextField" promptText="Nhập lại mật khẩu" styleClass="input-field" visible="false" />
                                    <ToggleButton fx:id="toggleConfirmPasswordBtn" mnemonicParsing="false" onAction="#toggleConfirmPasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand;" text="👁">
                                        <StackPane.margin>
                                            <Insets right="5.0" />
                                        </StackPane.margin>
                                    </ToggleButton>
                                </children>
                            </StackPane>
                        </VBox>
                    </children>
                </VBox>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                        onAction="#handleRegister" styleClass="login-button" text="Đăng ký">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>

                <HBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="Đã có tài khoản?" />
                        <Hyperlink onAction="#goToLogin" styleClass="register-link" text="Đăng nhập" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>