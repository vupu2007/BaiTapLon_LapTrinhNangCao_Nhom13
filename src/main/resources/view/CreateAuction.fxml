<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #F0F9FF; -fx-background: #F0F9FF; -fx-border-color: #F0F9FF; -fx-background-insets: 0; -fx-padding: 0;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.CreateProductController">
    <content>
        <VBox fillWidth="true" maxWidth="1.7976931348623157E308" spacing="25.0" style="-fx-background-color: #F0F9FF;">

            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="25.0" />
            </padding>

            <children>
                <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                    <children>
                        <Label style="-fx-text-fill: #1a73e8; -fx-font-weight: bold;" text="Tạo sản phẩm mới" textFill="#1a73e8">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Label text="Đăng bán sản phẩm của bạn vào hệ thống đấu giá" textFill="#64748b">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 8);">
                    <children>

                        <VBox spacing="8.0">
                            <children>
                                <Label text="📦  Tên sản phẩm" textFill="#1e293b">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="productNameField" prefHeight="45.0" promptText="VD: iPhone 15 Pro Max 256GB" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-color: white;">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </TextField>
                            </children>
                        </VBox>

                        <VBox spacing="8.0">
                            <children>
                                <Label text="📄  Mô tả" textFill="#1e293b">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextArea fx:id="descriptionArea" prefHeight="100.0" promptText="Mô tả chi tiết về tình trạng sản phẩm..." style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-color: white;" wrapText="true">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </TextArea>
                            </children>
                        </VBox>

                        <VBox spacing="8.0">
                            <children>
                                <Label text="💲  Giá khởi điểm (đ)" textFill="#1e293b">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="startPriceField" prefHeight="45.0" promptText="VD: 25000000" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-color: white;">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </TextField>
                            </children>
                        </VBox>

                        <VBox spacing="8.0">
                            <children>
                                <Label text="🖼️  Hình ảnh sản phẩm" textFill="#1e293b">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Button fx:id="btnUploadImage" mnemonicParsing="false" onAction="#handleUploadImage" prefHeight="45.0" style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text="📁 Chọn hình ảnh..." textFill="#334155">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                            <padding>
                                                <Insets left="20.0" right="20.0" />
                                            </padding>
                                        </Button>
                                        <Label fx:id="lblImagePath" text="Chưa chọn tệp nào" textFill="#64748b">
                                            <font>
                                                <Font size="13.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <HBox spacing="25.0">
                            <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="📅  Thời gian bắt đầu" textFill="#1e293b">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <HBox spacing="10.0">
                                            <children>
                                                <DatePicker fx:id="startDatePicker" maxWidth="Infinity" prefHeight="45.0" promptText="Chọn ngày" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;" HBox.hgrow="ALWAYS" />
                                                <ComboBox fx:id="startHourCombo" prefHeight="45.0" prefWidth="85.0" promptText="Giờ" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;" />
                                                <ComboBox fx:id="startMinuteCombo" prefHeight="45.0" prefWidth="85.0" promptText="Phút" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="⏳  Thời gian kết thúc" textFill="#1e293b">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <HBox spacing="10.0">
                                            <children>
                                                <DatePicker fx:id="endDatePicker" maxWidth="Infinity" prefHeight="45.0" promptText="Chọn ngày" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;" HBox.hgrow="ALWAYS" />
                                                <ComboBox fx:id="endHourCombo" prefHeight="45.0" prefWidth="85.0" promptText="Giờ" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;" />
                                                <ComboBox fx:id="endMinuteCombo" prefHeight="45.0" prefWidth="85.0" promptText="Phút" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <padding>
                                <Insets top="15.0" />
                            </padding>
                            <children>
                                <Button fx:id="btnCancel" mnemonicParsing="false" onAction="#handleCancel" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-cursor: hand;" text="Hủy" textFill="#475569">
                                    <font>
                                        <Font name="System Bold" size="15.0" />
                                    </font>
                                </Button>
                                <Button mnemonicParsing="false" onAction="#handleCreateAuction" prefHeight="45.0" prefWidth="400.0" style="-fx-background-color: linear-gradient(to right, #1a73e8, #0284c7); -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(26, 115, 232, 0.2), 8, 0, 0, 3);" text="Tạo phiên đấu giá" textFill="WHITE" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font name="System Bold" size="15.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>