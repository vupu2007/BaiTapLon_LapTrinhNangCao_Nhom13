<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefWidth="300.0" spacing="10.0" styleClass="product-card" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <StackPane>
            <children>
                <ImageView fx:id="productImage" fitHeight="200.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true" />
                <Label fx:id="statusBadge" styleClass="status-badge" StackPane.alignment="TOP_RIGHT">
                    <padding>
                        <Insets bottom="3.0" left="8.0" right="8.0" top="3.0" />
                    </padding>
                </Label>
            </children>
        </StackPane>

        <Label fx:id="productName" styleClass="field-label" text="Tên sản phẩm" wrapText="true" />
        <Label fx:id="productDesc" styleClass="demo-text" text="Mô tả..." wrapText="true" />

        <HBox alignment="CENTER_LEFT">
            <children>
                <Label text="Giá hiện tại: " />
                <Label fx:id="currentPrice" styleClass="price" text="0 đ" />
            </children>
        </HBox>

        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="actionButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Hành động" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</VBox>