<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #F0F9FF; -fx-background: #F0F9FF; -fx-border-color: #F0F9FF; -fx-background-insets: 0; -fx-padding: 0;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.MyProductsController">
    <content>
        <VBox fillWidth="true" maxWidth="1.7976931348623157E308" spacing="25.0" style="-fx-background-color: #F0F9FF;">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="25.0" />
            </padding>
            <children>
                <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                    <children>
                        <Label text="Sản phẩm đang bán" style="-fx-text-fill: #1a73e8;">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Label text="Quản lý các sản phẩm bạn đang đăng bán trên hệ thống" textFill="#64748b">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <HBox spacing="20.0">
                    <children>
                        <VBox prefHeight="130.0" spacing="10.0" style="-fx-background-color: linear-gradient(to right, #1a73e8, #0ea5e9); -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(26, 115, 232, 0.15), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="📦  Tổng phiên" textFill="#f0f9ff"><font><Font name="System Bold" size="16.0" /></font></Label>
                                <Label fx:id="lblTotalAuctions" text="0" textFill="WHITE"><font><Font name="System Bold" size="36.0" /></font></Label>
                            </children>
                            <padding><Insets bottom="20.0" left="25.0" right="25.0" top="20.0" /></padding>
                        </VBox>
                        <VBox prefHeight="130.0" spacing="10.0" style="-fx-background-color: linear-gradient(to right, #10b981, #059669); -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(16, 185, 129, 0.15), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="🕒  Đang diễn ra" textFill="#ecfdf5"><font><Font name="System Bold" size="16.0" /></font></Label>
                                <Label fx:id="lblActiveAuctions" text="0" textFill="WHITE"><font><Font name="System Bold" size="36.0" /></font></Label>
                            </children>
                            <padding><Insets bottom="20.0" left="25.0" right="25.0" top="20.0" /></padding>
                        </VBox>
                        <VBox prefHeight="130.0" spacing="10.0" style="-fx-background-color: linear-gradient(to right, #a855f7, #ec4899); -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(168, 85, 247, 0.15), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="💲  Tổng giá trị" textFill="#fdf2f8"><font><Font name="System Bold" size="16.0" /></font></Label>
                                <Label fx:id="lblTotalValue" text="0 đ" textFill="WHITE"><font><Font name="System Bold" size="36.0" /></font></Label>
                            </children>
                            <padding><Insets bottom="20.0" left="25.0" right="25.0" top="20.0" /></padding>
                        </VBox>
                    </children>
                </HBox>

                <StackPane minHeight="450.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
                    <children>
                        <VBox fx:id="emptyStateView" alignment="CENTER" spacing="20.0">
                            <children>
                                <Label style="-fx-font-size: 80.0;" text="📦" textFill="#cbd5e1" />
                                <Label text="Bạn chưa có sản phẩm nào đang bán" textFill="#64748b"><font><Font size="16.0" /></font></Label>
                                <Button onAction="#handleGoToCreateProduct" prefHeight="45.0" style="-fx-background-color: linear-gradient(to right, #1a73e8, #0284c7); -fx-background-radius: 8;" text="Tạo sản phẩm ngay" textFill="WHITE"><font><Font name="System Bold" size="15.0" /></font></Button>
                            </children>
                        </VBox>

                        <FlowPane fx:id="productsGrid" alignment="TOP_LEFT" hgap="25.0" vgap="25.0" />
                    </children>
                </StackPane>
            </children>
        </VBox>
    </content>
</ScrollPane>
