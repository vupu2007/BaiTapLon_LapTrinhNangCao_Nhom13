<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700" prefWidth="1200" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.MyProductController">

    <left>
        <VBox fx:id="sidebar" prefWidth="220" spacing="10.0" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>
                <Button onAction="#toggleSidebar" styleClass="toggle-btn" text="≡">
               <font>
                  <Font size="21.0" />
               </font></Button>
            </HBox>

            <Button fx:id="btnHome" lineSpacing="10.0" prefHeight="27.0" prefWidth="237.0" styleClass="menu-item" text="🏠  Trang chủ" />
            <Button fx:id="btnProducts" prefHeight="27.0" prefWidth="224.0" styleClass="menu-item, active" text="📦  Sản phẩm của tôi" />
            <Button fx:id="btnCreate" prefHeight="27.0" prefWidth="221.0" styleClass="menu-item" text="🔨  Đang đấu giá" />
         <Button mnemonicParsing="false" prefHeight="27.0" prefWidth="224.0" text="👜  Tạo phiên đấu giá" />
            <Button fx:id="btnHistory" prefHeight="27.0" prefWidth="222.0" styleClass="menu-item" text="🕘  Lịch sử" />
         <Button mnemonicParsing="false" prefHeight="27.0" prefWidth="220.0" text="💳 Ví tiền " />
         <Button mnemonicParsing="false" prefHeight="22.0" prefWidth="220.0" text="⚙  Cài đặt" />
        </VBox>
    </left>

    <center>
        <VBox spacing="0" styleClass="main-bg">
            <children>
                <HBox alignment="CENTER_RIGHT" prefHeight="60.0" spacing="10.0">
                    <padding>
                        <Insets right="20" />
                    </padding>
                    <Label style="-fx-text-fill: #555555; -fx-font-size: 14;" text="Xin chào, Trần Thị B" />
                    <Button styleClass="logout-btn" text="Đăng xuất" />
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <VBox spacing="20">
                        <padding>
                            <Insets bottom="20" left="20" right="20" top="10" />
                        </padding>

                        <HBox spacing="10.0" styleClass="header-card">
                            <padding>
                                <Insets bottom="20" left="20" right="20" top="20" />
                            </padding>
                            <Label styleClass="header-icon" text="📦" />
                            <VBox>
                                <Label styleClass="header-title" text="Sản phẩm của tôi" />
                                <Label styleClass="header-sub" text="Quản lý các sản phẩm bạn đang bán" />
                            </VBox>
                        </HBox>

                        <HBox spacing="20">
                            <VBox styleClass="card">
                                <Label text="Sản phẩm đang bán" textFill="#666666" />
                                <Label styleClass="card-number" text="0" />
                            </VBox>
                            <VBox styleClass="card">
                                <Label text="Tổng doanh thu dự kiến" textFill="#666666" />
                                <Label styleClass="card-money" text="0.0M đ" />
                            </VBox>
                            <VBox styleClass="card">
                                <Label text="Tổng lượt đấu giá" textFill="#666666" />
                                <Label styleClass="card-number" text="0" />
                            </VBox>
                        </HBox>

                        <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="20" left="20" right="20" top="20" />
                            </padding>
                            <Label styleClass="section-title" text="Danh sách sản phẩm" />
                            <VBox alignment="CENTER" prefHeight="300" spacing="10.0" styleClass="empty-box">
                                <Label style="-fx-font-size: 40;" text="📦" />
                                <Label style="-fx-text-fill: #666666;" text="Bạn chưa có sản phẩm nào" />
                                <Label style="-fx-text-fill: #999999;" text="Tạo phiên đấu giá mới để bắt đầu!" />
                            </VBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>
