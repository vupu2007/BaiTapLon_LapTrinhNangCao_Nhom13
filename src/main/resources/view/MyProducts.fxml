<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.controller.MyProductController"
            prefWidth="1200" prefHeight="700"
            stylesheets="@/css/product_card.css">

    <!-- SIDEBAR -->
    <left>
        <VBox fx:id="sidebar" prefWidth="220" styleClass="sidebar">

            <!-- Toggle -->
            <HBox alignment="CENTER_LEFT">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <Button text="☰"
                        onAction="#toggleSidebar"
                        styleClass="toggle-btn"/>
            </HBox>

            <!-- Menu -->
            <Button text="🏠  Trang chủ" styleClass="menu-item"/>
            <Button text="📦  Sản phẩm của tôi" styleClass="menu-item"/>
            <Button text="➕  Tạo phiên đấu giá" styleClass="menu-item"/>
            <Button text="🕘  Lịch sử" styleClass="menu-item"/>

        </VBox>
    </left>

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="15" styleClass="topbar">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>

            <Label text="Xin chào, Trần Thị B" styleClass="topbar-text"/>
            <Button text="Đăng xuất" styleClass="logout-btn"/>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <VBox spacing="20" styleClass="main-bg">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- HEADER -->
            <HBox spacing="15" styleClass="header-card">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="📦" styleClass="header-icon"/>

                <VBox>
                    <Label text="Sản phẩm của tôi" styleClass="header-title"/>
                    <Label text="Quản lý các sản phẩm bạn đang bán" styleClass="header-sub"/>
                </VBox>
            </HBox>

            <!-- STATS -->
            <HBox spacing="20">
                <VBox styleClass="card">
                    <Label text="Sản phẩm đang bán"/>
                    <Label text="0" styleClass="card-number"/>
                </VBox>

                <VBox styleClass="card">
                    <Label text="Tổng doanh thu dự kiến"/>
                    <Label text="0.0M đ" styleClass="card-money"/>
                </VBox>

                <VBox styleClass="card">
                    <Label text="Tổng lượt đấu giá"/>
                    <Label text="0" styleClass="card-number"/>
                </VBox>
            </HBox>

            <!-- LIST -->
            <VBox spacing="15" styleClass="card">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Danh sách sản phẩm" styleClass="section-title"/>

                <VBox alignment="CENTER" spacing="10" prefHeight="200"
                      styleClass="empty-box">
                    <Label text="📦" styleClass="empty-icon"/>
                    <Label text="Bạn chưa có sản phẩm nào"/>
                    <Label text="Tạo phiên đấu giá mới để bắt đầu!"/>
                </VBox>
            </VBox>

        </VBox>
    </center>

</BorderPane>