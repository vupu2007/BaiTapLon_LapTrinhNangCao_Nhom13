<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F0F9FF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <content>
        <VBox fillWidth="true" maxWidth="1.7976931348623157E308" spacing="25.0" style="-fx-background-color: #F0F9FF;">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="25.0" />
            </padding>
            <children>

                <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                    <children>
                        <Label text="Sản phẩm đang bán" textFill="#1a73e8">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Label text="Quản lý các sản phẩm bạn đang đăng bán trên hệ thống" textFill="#64748b">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <HBox spacing="20.0">
                    <children>
                        <VBox prefHeight="130.0" spacing="10.0" style="-fx-background-color: linear-gradient(to right, #0284c7, #0ea5e9); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="📦  Tổng phiên" textFill="#f0f9ff">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Label text="0" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="36.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets top="5.0" />
                                    </VBox.margin>
                                </Label>
                            </children>
                            <padding>
                                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                            </padding>
                        </VBox>

                        <VBox prefHeight="130.0" spacing="10.0" style="-fx-background-color: #10b981; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="🕒  Đang diễn ra" textFill="#ecfdf5">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Label text="0" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="36.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets top="5.0" />
                                    </VBox.margin>
                                </Label>
                            </children>
                            <padding>
                                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                            </padding>
                        </VBox>

                        <VBox prefHeight="130.0" spacing="10.0" style="-fx-background-color: linear-gradient(to right, #a855f7, #ec4899); -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="💲  Tổng giá trị" textFill="#fdf2f8">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Label text="0 đ" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="36.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets top="5.0" />
                                    </VBox.margin>
                                </Label>
                            </children>
                            <padding>
                                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                            </padding>
                        </VBox>
                    </children>
                </HBox>

                <VBox alignment="CENTER" prefHeight="400.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="📦" textFill="#cbd5e1">
                            <font>
                                <Font size="80.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="-10.0" />
                            </VBox.margin>
                        </Label>

                        <Label text="Bạn chưa có sản phẩm nào đang bán" textFill="#64748b">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>

                        <Button mnemonicParsing="false" prefHeight="45.0" style="-fx-background-color: #0ea5e9; -fx-background-radius: 8; -fx-cursor: hand;" text="Tạo sản phẩm ngay" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                            <padding>
                                <Insets left="30.0" right="30.0" />
                            </padding>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="40.0" top="40.0" />
                    </padding>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>