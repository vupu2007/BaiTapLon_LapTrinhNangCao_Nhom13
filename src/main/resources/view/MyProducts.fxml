<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: #f3f4f6; -fx-padding: 30;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label text="&lt;&gt;Sản phẩm của tôi" textFill="#1f2937">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 20; -fx-font-weight: bold;" text="+ Đăng sản phẩm mới" />
            </children>
        </HBox>

        <!-- Bảng quản lý sản phẩm -->
        <TableView style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e5e7eb; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 3);" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn prefWidth="80.0" text="Mã SP" />
                <TableColumn prefWidth="250.0" text="Tên sản phẩm" />
                <TableColumn prefWidth="150.0" text="Giá khởi điểm" />
                <TableColumn prefWidth="150.0" text="Thời gian kết thúc" />
                <TableColumn prefWidth="120.0" text="Trạng thái" />
                <TableColumn prefWidth="150.0" text="Thao tác" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
