<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane alignment="CENTER"
           prefHeight="750.0"
           prefWidth="500.0"
           style="-fx-background-color: #f0f7ff;"
           stylesheets="@../css/login.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.controller.ForgotPasswordController">
    <children>
        <VBox alignment="TOP_CENTER"
              maxHeight="-Infinity"
              maxWidth="-Infinity"
              prefWidth="420.0"
              spacing="12.0"
              styleClass="login-card">
            <padding>
                <Insets top="30.0" right="40.0" bottom="30.0" left="40.0"/>
            </padding>
            <children>
                <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@../images/uet_logo.png"/>
                    </image>
                </ImageView>

                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="Khôi phục mật khẩu" styleClass="title-main"/>
                        <Label text="Nhập thông tin tài khoản để nhận mã OTP" styleClass="title-sub"/>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0"/>
                    </VBox.margin>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Tên đăng nhập" styleClass="field-label"/>
                        <TextField fx:id="txtUsername" promptText="Nhập tên đăng nhập" styleClass="input-field"/>
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Địa chỉ Email" styleClass="field-label"/>
                        <TextField fx:id="txtEmail" promptText="Nhập email đăng ký tài khoản" styleClass="input-field"/>
                    </children>
                </VBox>

                <Button text="Gửi mã OTP"
                        maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false"
                        onAction="#handleSendOTP"
                        styleClass="login-button">
                    <VBox.margin>
                        <Insets top="15.0"/>
                    </VBox.margin>
                </Button>

                <HBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Hyperlink text="Quay lại đăng nhập"
                                   onAction="#handleBackToLogin"
                                   styleClass="register-link"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>