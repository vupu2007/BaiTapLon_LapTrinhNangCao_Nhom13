<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: #F0F9FF;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.MainController">
    <content>
        <VBox fillWidth="true" maxWidth="1.7976931348623157E308" spacing="25.0" style="-fx-background-color: #F0F9FF;">
            <stylesheets>
                <URL value="@../css/style.css" />
            </stylesheets>

            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="25.0" />
            </padding>

            <children>
                <VBox spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                    <children>
                        <Label text="Danh sách phiên đấu giá" textFill="#1a73e8">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Label text="Khám phá các sản phẩm đang được đấu giá" textFill="#64748b">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label text="(!) Lưu ý: Mỗi lần đặt giá phải cao hơn giá hiện tại ít nhất 10% giá khởi điểm của sản phẩm." textFill="#dc2626" style="-fx-font-size: 13; -fx-font-style: italic;"/>
                    </children>
                </VBox>

                <VBox fillWidth="true" maxWidth="1.7976931348623157E308" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 8);" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <TextField prefHeight="40.0" prefWidth="400.0" promptText="🔍 Tìm kiếm sản phẩm..." styleClass="search-field" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-color: white;">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </TextField>
                                <Region HBox.hgrow="ALWAYS" />

                                <Button fx:id="btnFilterAll" mnemonicParsing="false" onAction="#handleFilterAll" prefHeight="40.0" style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 0 20;" text="Tất cả" />

                                <Button fx:id="btnFilterActive" mnemonicParsing="false" onAction="#handleFilterActive" prefHeight="40.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 0 20;" text="Đang diễn ra" />

                                <Button fx:id="btnFilterUpcoming" mnemonicParsing="false" onAction="#handleFilterUpcoming" prefHeight="40.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 0 20;" text="Sắp diễn ra" />
                            </children>
                        </HBox>

                        <FlowPane fx:id="flowPane" hgap="25.0" maxWidth="1.7976931348623157E308" vgap="25.0" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets top="30.0" />
                            </padding>
                            <children>
                            </children>
                        </FlowPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>