<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" prefHeight="720.0" prefWidth="1200.0" style="-fx-background-color: #f0f7f9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.MainController">
    <stylesheets>
        <URL value="@/css/main_style.css" />
    </stylesheets>
    <left>
        <VBox fx:id="sidebar" prefWidth="250.0" styleClass="sidebar">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0">
                    <padding><Insets left="20.0" /></padding>
                    <Button fx:id="btnToggle" mnemonicParsing="false" onAction="#toggleSidebar" styleClass="hamburger-btn" text="☰" />
                </HBox>

                <VBox fx:id="menuContainer" spacing="10.0" VBox.vgrow="ALWAYS">
                    <padding><Insets left="15.0" right="15.0" top="20.0" /></padding>

                    <Button fx:id="btnHome" maxWidth="1.7976931348623157E308" styleClass="menu-item, active" text="🏠  Trang chủ" />

                    <Button fx:id="btnBidding" maxWidth="1.7976931348623157E308" styleClass="menu-item" text="🔨  Đang đấu giá" />

                    <Button fx:id="btnSelling" maxWidth="1.7976931348623157E308" styleClass="menu-item" text="📦  Đang bán" />

                    <Button fx:id="btnCreate" maxWidth="1.7976931348623157E308" styleClass="menu-item" text="👜  Tạo phiên đấu giá" />

                    <Button fx:id="btnHistory" maxWidth="1.7976931348623157E308" styleClass="menu-item" text="🕒  Lịch sử" />

                    <Button fx:id="btnSettings" maxWidth="1.7976931348623157E308" styleClass="menu-item" text="⚙️  Cài đặt" />
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="20.0" /></padding>
            <children>
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <Label text="Xin chào, Trần Thị B" textFill="#555555" />
                    <Button styleClass="btn-logout" text="Đăng xuất" />
                </HBox>

                <VBox styleClass="banner-card" prefHeight="200.0" VBox.vgrow="NEVER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="30.0">
                            <padding><Insets left="40.0" /></padding>
                            <Label style="-fx-font-size: 50px;" styleClass="icon-box" text="🏠" />
                            <VBox alignment="CENTER_LEFT">
                                <Label style="-fx-font-size: 32px; -fx-font-weight: bold;" styleClass="banner-title" text="Trang chủ" />
                                <Label style="-fx-font-size: 16px;" styleClass="banner-subtitle" text="Hệ thống đấu giá trực tuyến chuyên nghiệp - Chào mừng bạn quay trở lại!" />
                            </VBox>
                        </HBox>
                    </children>
                </VBox>

                <HBox spacing="20.0" maxWidth="1.7976931348623157E308">
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" prefHeight="120.0" alignment="CENTER">
                        <Label text="Phiên đang mở" style="-fx-font-size: 16px;" />
                        <Label styleClass="stat-value" text="12" style="-fx-font-size: 36px;" />
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" prefHeight="120.0" alignment="CENTER">
                        <Label text="Số dư khả dụng" style="-fx-font-size: 16px;" />
                        <Label styleClass="stat-value-green" text="10.0M đ" style="-fx-font-size: 36px;" />
                    </VBox>
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" prefHeight="120.0" alignment="CENTER">
                        <Label text="Thông báo mới" style="-fx-font-size: 16px;" />
                        <Label styleClass="stat-value" text="05" style="-fx-font-size: 36px; -fx-text-fill: #f39c12;" />
                    </VBox>
                </HBox>

                <VBox styleClass="main-content-area" VBox.vgrow="ALWAYS">
                    <Label styleClass="section-title" text="Phiên đấu giá nổi bật" />
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                        <FlowPane hgap="20.0" vgap="20.0">
                            <VBox styleClass="auction-card">
                                <Region prefHeight="150.0" style="-fx-background-color: #f9f9f9; -fx-background-radius: 10;" />
                                <Label style="-fx-font-weight: bold;" text="iPhone 15 Pro Max" />
                                <HBox>
                                    <Label text="Giá hiện tại: " />
                                    <Label style="-fx-text-fill: #1491a3; -fx-font-weight: bold;" text="25.000.000 đ" />
                                </HBox>
                                <Button maxWidth="1.7976931348623157E308" styleClass="btn-bid" text="Đấu giá ngay" />
                            </VBox>
                        </FlowPane>
                    </ScrollPane>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>