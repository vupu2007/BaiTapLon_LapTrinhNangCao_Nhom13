<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.URL?>

<VBox spacing="25.0"
      style="-fx-background-color: #F0F9FF;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">

    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <padding>
        <Insets top="25.0"
                right="25.0"
                bottom="25.0"
                left="15.0"/>
    </padding>

    <!-- HEADER -->

    <VBox styleClass="shadow-pane">

        <padding>
            <Insets top="30.0"
                    right="30.0"
                    bottom="30.0"
                    left="30.0"/>
        </padding>

        <Label text="Danh sách phiên đấu giá"
               textFill="#0284c7">

            <font>
                <Font name="System Bold" size="28.0"/>
            </font>

        </Label>

        <Label text="Khám phá các sản phẩm đang được đấu giá"
               textFill="#64748b"/>

    </VBox>

    <!-- CONTENT -->

    <VBox styleClass="shadow-pane"
          VBox.vgrow="ALWAYS">

        <padding>
            <Insets top="25.0"
                    right="25.0"
                    bottom="20.0"
                    left="25.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT"
              spacing="15.0">

            <TextField prefWidth="450.0"
                       promptText="🔍 Tìm kiếm sản phẩm..."
                       styleClass="search-field"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button prefHeight="35"
                    prefWidth="80"
                    style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-background-radius: 10;"
                    text="Tất cả"/>

            <Button prefHeight="35"
                    style="-fx-background-color: #f1f5f9; -fx-background-radius: 10;"
                    text="Đang diễn ra"/>

            <Button prefHeight="35"
                    style="-fx-background-color: #f1f5f9; -fx-background-radius: 10;"
                    text="Sắp diễn ra"/>

        </HBox>

        <FlowPane hgap="20.0"
                  vgap="20.0"
                  VBox.vgrow="ALWAYS">

            <padding>
                <Insets top="25.0"/>
            </padding>

        </FlowPane>

    </VBox>

</VBox>