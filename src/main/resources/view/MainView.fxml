<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<BorderPane style="-fx-background-color: #F0F9FF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.MainController">
    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="90.0" spacing="25.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets left="40.0" right="40.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <ImageView fitHeight="55.0" preserveRatio="true">
                    <Image url="@../images/uet_logo.png" />
                </ImageView>
                <VBox alignment="CENTER_LEFT">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 24;" text="Đấu Giá UET" textFill="#0056b3" />
                    <Label style="-fx-font-size: 13;" text="Đại học Công nghệ - ĐHQGHN" textFill="#64748b" />
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Label style="-fx-background-color: #f1f5f9; -fx-padding: 10 22; -fx-background-radius: 12; -fx-font-weight: bold; -fx-font-size: 15;" text="👤 minh huyền" />

            <MenuButton fx:id="roleMenuButton" mnemonicParsing="false" style="-fx-background-color: #A21CAF; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 5 10;" text="🔄 Người mua">
                <items>
                    <MenuItem onAction="#switchToBuyer" text="Người mua - Tham gia đấu giá" />
                    <MenuItem onAction="#switchToSeller" text="Người bán - Quản lý sản phẩm" />
                </items>
            </MenuButton>

            <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 10 20;" text="🚪 Đăng xuất" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="320.0" spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="15.0" top="30.0" />
            </padding>

            <VBox fx:id="roleBox" style="-fx-background-color: #fae8ff; -fx-background-radius: 20; -fx-padding: 25;">
                <Label fx:id="lblRoleTitle" style="-fx-font-size: 14; -fx-font-weight: bold;" text="Tư cách hiện tại" textFill="#86198f" />
                <Label fx:id="lblRoleSidebar" style="-fx-font-weight: bold; -fx-font-size: 24;" text="🛒 Người mua" textFill="#86198f" />
            </VBox>

            <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 25;" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="25.0" left="20.0" right="20.0" top="25.0" />
                </padding>

                <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="60.0" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-size: 17px; -fx-font-weight: bold;" text="🏠 Trang chủ" />

                <VBox fx:id="buyerMenu" spacing="12.0">
                    <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="60.0" style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-font-size: 17px; -fx-font-weight: bold;" text="👛 Ví tiền" />
                    <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="60.0" style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-font-size: 17px; -fx-font-weight: bold;" text="🔨 Đang đấu giá" />
                </VBox>

                <VBox fx:id="sellerMenu" managed="false" spacing="12.0" visible="false">
                    <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="60.0" style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-font-size: 17px; -fx-font-weight: bold;" text="👛 Ví tiền" />
                    <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="60.0" style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-font-size: 17px; -fx-font-weight: bold;" text="📦 Đang bán" />
                    <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="60.0" style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-font-size: 17px; -fx-font-weight: bold;" text="➕ Tạo phiên đấu giá" />
                </VBox>

                <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="60.0" style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-font-size: 17px; -fx-font-weight: bold;" text="🕒 Lịch sử" />
                <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" prefHeight="60.0" style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-font-size: 17px; -fx-font-weight: bold;" text="⚙ Cài đặt" />
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F0F9FF;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="20.0" right="30.0" top="30.0" />
            </padding>
            <VBox spacing="30.0">
                <VBox style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 20, 0, 0, 8);">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 36;" text="Danh sách phiên đấu giá" textFill="#0284c7" />
                    <Label style="-fx-font-size: 16;" text="Khám phá các sản phẩm đang được đấu giá" textFill="#64748b" />
                </VBox>

                <VBox spacing="25" style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 35; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 20, 0, 0, 8);">
                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <TextField prefHeight="55.0" prefWidth="550.0" promptText="🔍 Tìm kiếm sản phẩm..." style="-fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-background-color: white; -fx-font-size: 16px;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 12 30; -fx-font-weight: bold; -fx-font-size: 16;" text="Tất cả" />
                    </HBox>

                    <FlowPane hgap="30.0" vgap="30.0">
                        <VBox prefWidth="320.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 15, 0, 0, 4); -fx-border-color: #f1f5f9; -fx-border-radius: 20;">
                            <Region prefHeight="220.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 20 20 0 0;" />
                            <VBox spacing="10" style="-fx-padding: 22;">
                                <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="Sản phẩm mẫu" />
                                <Label style="-fx-font-size: 14;" text="Mô tả ngắn gọn về sản phẩm đấu giá..." textFill="#64748b" />
                            </VBox>
                        </VBox>
                    </FlowPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>