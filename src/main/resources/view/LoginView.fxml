<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane alignment="CENTER"
           prefHeight="750.0"
           prefWidth="500.0"
           style="-fx-background-color: #f0f7ff;"
           stylesheets="@../css/login.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.controller.LoginController">
    <children>
        <VBox alignment="TOP_CENTER"
              maxHeight="-Infinity"
              maxWidth="-Infinity"
              prefWidth="420.0"
              spacing="12.0"
              styleClass="login-card">
            <padding>
                <Insets top="30.0"
                        right="40.0"
                        bottom="30.0"
                        left="40.0"/>
            </padding>
            <children>
                <!-- LOGO -->
                <ImageView fitHeight="80.0"
                           fitWidth="80.0"
                           pickOnBounds="true"
                           preserveRatio="true"
                           smooth="true">
                    <image>
                        <Image url="@../images/uet_logo.png"/>
                    </image>
                </ImageView>
                <!-- TITLE -->
                <VBox alignment="CENTER"
                      spacing="5.0">
                    <children>
                        <Label text="Đấu Giá UET"
                               styleClass="title-main"/>

                        <Label text="Đại học Công nghệ - ĐHQG Hà Nội"
                               styleClass="title-sub"/>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0"/>
                    </VBox.margin>
                </VBox>
                <!-- USERNAME -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="Tên đăng nhập"
                               styleClass="field-label"/>
                        <TextField fx:id="usernameField"
                                   promptText="Nhập tên đăng nhập"
                                   styleClass="input-field"/>
                    </children>
                </VBox>
                <!-- PASSWORD -->
                <VBox spacing="5.0">
                    <children>
                        <Label text="Mật khẩu"
                               styleClass="field-label"/>
                        <StackPane alignment="CENTER_RIGHT">
                            <children>
                                <PasswordField fx:id="passwordField"
                                               promptText="Nhập mật khẩu"
                                               styleClass="input-field"
                                               onAction="#handleLogin"/>
                                <TextField fx:id="visiblePasswordField"
                                           promptText="Nhập mật khẩu"
                                           styleClass="input-field"
                                           visible="false"
                                           managed="false"
                                           onAction="#handleLogin"/>
                                <ToggleButton fx:id="togglePasswordBtn"
                                              text="👁"
                                              mnemonicParsing="false"
                                              onAction="#togglePasswordVisibility"
                                              style="-fx-background-color: transparent; -fx-cursor: hand;">
                                    <StackPane.margin>
                                        <Insets right="5.0"/>
                                    </StackPane.margin>
                                </ToggleButton>
                            </children>
                        </StackPane>
                    </children>
                </VBox>
                <!-- FORGOT PASSWORD -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Hyperlink text="Quên mật khẩu?"
                                   styleClass="forgot-link"/>
                    </children>
                </HBox>
                <!-- LOGIN BUTTON -->
                <Button text="Đăng nhập"
                        maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false"
                        onAction="#handleLogin"
                        styleClass="login-button">
                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>
                </Button>
                <!-- REGISTER -->
                <HBox alignment="CENTER"
                      spacing="5.0">
                    <children>
                        <Label text="Chưa có tài khoản?"/>

                        <Hyperlink text="Đăng ký ngay"
                                   onAction="#goToRegister"
                                   styleClass="register-link"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>